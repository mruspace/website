---
// The old URL of the Architecture page. GitHub Pages has no server
// redirects, so this page sends the reader on. Not indexed; the SEO check
// skips it because of the refresh.
import { SITE } from '../../data/site';

const to = '/architecture/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Moved to Architecture · Mru Aerospace</title>
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, SITE.url).href} />
  </head>
  <body>
    <p>
      This page moved to <a href={to}>Architecture</a>.
    </p>
  </body>
</html>
