---
import Base from '../layouts/Base.astro';
import Descent from '../components/Descent.astro';
---

<Base rootClass="glow" mainClass="wrap section" mainStyle="text-align: center">
  <div class="stack-m" style="max-width: 720px; margin: 0 auto">
    <p class="eyebrow"><span class="n">404</span> · Not found</p>
    <h1 class="h1">This page stopped.<br />The rest is still running.</h1>
    <p class="lede">The link may be old, or the page moved. Everything else is where you left it.</p>
  </div>
  <Descent variant="strands" style="margin: 64px auto; max-width: 960px" />
  <div class="row" style="justify-content: center">
    <a class="btn" href="/">Home</a>
    <a class="btn ghost" href="/use-cases/">Use cases</a>
    <a class="btn ghost" href="/research/">Research</a>
    <a class="btn ghost" href="https://docs.mru.space/">Docs</a>
  </div>
</Base>
