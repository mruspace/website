---
// The research log (canvas Research artboard). Entries come from the
// research collection, newest first.
import Base from '../../layouts/Base.astro';
import Chart from '../../components/Chart.astro';
import { entries, hrefOf, dateLabel, KIND_SLUGS } from '../../data/research';
import { SITE } from '../../data/site';

const all = await entries();
const latest = all.find((e) => e.data.featured)!;
const f = latest.data.featured!;
const oldest = all[all.length - 1]!;
const paper = all.find((e) => e.data.kind === 'Paper' && e.data.bibtex)!;
const filters = [
  { label: 'All', slug: '' },
  { label: 'Papers', slug: KIND_SLUGS.Paper },
  { label: 'Results', slug: KIND_SLUGS.Results },
  { label: 'Releases', slug: KIND_SLUGS.Release },
  { label: 'Notes', slug: KIND_SLUGS.Note },
];
---

<Base
  ld={{
    blogPosts: all.map((e) => ({
      headline: e.data.title,
      url: new URL(hrefOf(e), SITE.url).href,
      datePublished: e.data.date,
    })),
  }}
  active="research"
  request={{ interest: 'research', heading: 'Questions about this work, or want to test it?' }}
>
  <section class="wrap hero" style="padding-bottom: 64px">
    <div class="hero-grid">
      <div class="stack-m">
        <p class="eyebrow">Research</p>
        <h1 class="h-hero">The log</h1>
      </div>
      <div class="stack-m">
        <p class="lede">
          Papers, results and releases, newest first. All of it is open: papers under CC BY 4.0, code under Apache 2.0.
        </p>
        <div class="row">
          <a class="link-more" href="/research/feed.xml">
            RSS feed
          </a>
          <a class="link-more" href="https://zenodo.org/records/20579438">
            Zenodo
          </a>
          <a class="link-more" href="https://github.com/mruspace">
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="latest">
    <a
      class="split rev"
      href={hrefOf(latest)}
      style="text-decoration: none; align-items: center; border-top: 1px solid var(--ink); padding-top: 32px"
    >
      <figure class="figure" style="margin: 0">
        <Chart name={f.chart} alt={f.chartAlt} />
      </figure>
      <div class="stack-m">
        <p class="eyebrow">
          <span class="n">№ {latest.data.number}</span> · {latest.data.kind} · Latest
        </p>
        <h2 id="latest" class="h2">
          {f.title}
        </h2>
        <p class="soft">{f.summary}</p>
        <p class="tiny">{f.line}</p>
      </div>
    </a>
  </section>

  <section class="wrap section" aria-label="All entries" style="padding-top: 96px">
    <div class="row" style="justify-content: space-between; margin-bottom: 24px">
      <nav class="filters" aria-label="Filter by kind" data-filters>
        {filters.map((x) => (
          <a
            class={x.slug === '' ? 'on' : undefined}
            href={x.slug ? `/research/?kind=${x.slug}` : '/research/'}
            data-kind={x.slug}
            aria-current={x.slug === '' ? 'true' : undefined}
          >
            {x.label}
          </a>
        ))}
      </nav>
      <span class="tiny" data-count>
        {all.length} entries since {dateLabel(oldest).replace(/^\d+ /, '')}
      </span>
    </div>
    <div class="log" data-log>
      {all.map((e) => (
        <a class="entry" href={hrefOf(e)} data-kind={KIND_SLUGS[e.data.kind]}>
          <span class="no">№ {e.data.number}</span>
          <span class="kind">{e.data.kind}</span>
          <div>
            <p class="t" style="margin: 0">
              {e.data.title}
            </p>
            <p class="sum" style="margin-bottom: 0">
              {e.data.summary}
            </p>
          </div>
          <span class="meta">
            {dateLabel(e)}
            <br />
            {e.data.metaLabel ?? e.data.readingTime}
          </span>
        </a>
      ))}
    </div>
    <p class="soft small" data-empty hidden>
      Nothing of this kind yet. The log above lists every entry.
    </p>
  </section>

  <section class="wrap section tight sunk" style="max-width: none">
    <div class="wrap split" style="padding-inline: 0">
      <div class="stack-m">
        <p class="eyebrow">Cite the whitepaper</p>
        <h2 class="h3">
          W. Binns, <em>Mru: A Fault-Tolerant Operating System for Thousand-Year Autonomous Operation</em>, 2026.
        </h2>
        <p class="tiny">doi:{paper.data.doi} · CC BY 4.0</p>
      </div>
      <pre class="pre" tabindex="0">{paper.data.bibtex}</pre>
    </div>
  </section>
</Base>

<script>
  import { initResearchFilters } from '../../scripts/research-filters';
  initResearchFilters();
</script>
