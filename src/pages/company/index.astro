---
import Base from '../../layouts/Base.astro';
import PlateImage from '../../components/PlateImage.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Picture } from 'astro:assets';
import { photo, creditLine } from '../../data/images';
import founder from '../../assets/founder/will-binns.jpg';

const crumbs = [{ label: 'Mru', href: '/' }, { label: 'Company' }];
---

<Base
  crumbs={crumbs}
  active="company"
  request={{ interest: 'other', heading: 'Operators, mission teams, partners: write to us.' }}
>
  <section class="wrap hero" style="padding-bottom: 64px">
    <Breadcrumbs items={crumbs} />
    <div class="hero-grid" style="margin-top: 40px">
      <h1 class="h1">Fault-tolerant software for hard-to-reach systems.</h1>
      <p class="lede">
        The long-term goal is software that runs for a thousand years. Along the way, the same software is built for
        systems that need it now: Mru Field on Earth and Mru Flight in space. We&#39;re inspired by other work built to
        outlast the people who started it.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="cards two">
      <figure class="plate">
        <div class="ph">
          <PlateImage photo={photo('17')} alt="Sagrada Família spires with tower cranes" />
        </div>
        <figcaption>
          <span class="cap">Sagrada Família, Barcelona. Under construction since 1882.</span>
          <span class="cr">{creditLine(photo('17'))}</span>
        </figcaption>
      </figure>
      <figure class="plate">
        <div class="ph">
          <PlateImage photo={photo('18')} alt="Gear mechanism of the 10,000 Year Clock" />
        </div>
        <figcaption>
          <span class="cap">The 10,000 Year Clock, Long Now Foundation.</span>
          <span class="cr">{creditLine(photo('18'))}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap section">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">The name</p>
        <h2 class="h2">Maru: a circle, and a ship on a long voyage.</h2>
      </div>
      <div class="stack-m">
        <p class="lede">
          Mru is a contraction of <em>Maru</em>, the suffix borne by seagoing vessels. It comes from the character for
          &#8220;circle&#8221;, connoting completeness and safe passage on a long voyage.
        </p>
        <p class="soft">The mark is that circle, with an orbit through it. It is the same on Earth and in space.</p>
      </div>
    </div>
  </section>

  <section class="wrap section" style="padding-top: 0">
    <div class="split rev" style="align-items: end">
      <figure class="plate">
        <div class="ph wide">
          <PlateImage photo={photo('19')} alt="Horta marina on Faial with Mount Pico behind" />
        </div>
        <figcaption>
          <span class="cap">Horta, Faial, with Pico behind.</span>
          <span class="cr">{creditLine(photo('19'))}</span>
        </figcaption>
      </figure>
      <div class="stack-m">
        <p class="eyebrow">Where</p>
        <h2 class="h2">In the middle of the Atlantic.</h2>
        <p class="soft">We work from Horta, in the Azores, close to deep-sea observatories and the open ocean.</p>
      </div>
    </div>
  </section>

  <section class="wrap section" style="padding-top: 0" id="founder">
    <div class="split">
      <figure class="plate" style="max-width: 320px">
        <div class="ph sq">
          <Picture
            src={founder}
            alt="Will Binns"
            widths={[320, 640]}
            sizes="320px"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            loading="lazy"
            decoding="async"
          />
        </div>
      </figure>
      <div class="stack-m">
        <div>
          <p class="eyebrow">Founder</p>
          <h2 class="h2">Will Binns</h2>
        </div>
        <ul class="sig-list" style="margin-top: 12px">
          <li>Led teams at Coinbase.</li>
          <li>
            Editor of O&#39;Reilly&#39;s <em>Mastering Bitcoin</em> and <em>Mastering Ethereum</em>.
          </li>
          <li>Former maintainer of bitcoin.org.</li>
          <li>Open-source contributor to ESA&#39;s pykep and the NanoSat MO Framework.</li>
        </ul>
      </div>
      <!-- TODO: advisors. None named yet. Add only after each one agrees. -->
      <!-- TODO: partners. None yet. Name a third party only after it accepts. -->
    </div>
  </section>
</Base>
