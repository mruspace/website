---
import Base from '../../layouts/Base.astro';
import Seam from '../../components/Seam.astro';
import PlateImage from '../../components/PlateImage.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { photo, creditLine } from '../../data/images';
import { t } from '../../data/claims';

const crumbs = [{ label: 'Mru', href: '/' }, { label: 'Mru Field' }];
const faq = [
  {
    q: 'Is it open source?',
    a: 'The decision core and the simulator are open source under Apache 2.0, and the whitepaper is published under CC BY 4.0. Mru Field adds integration and support for your site.',
  },
  {
    q: 'What evidence is there today?',
    a: `Simulation over ${t('dusk.runs')} missions, a fault-injection demo and a bench on real processes, ${t('flight.kani.total')} Kani proofs, one run in orbit on ESA's OPS-SAT PRETTY, and the supervisor's own tests and scenario checks on the bench, in its repository. None of it has run on your equipment yet.`,
  },
  {
    q: 'How is it priced?',
    a: 'An annual license per site or per fleet, with support. We discuss terms once we know the hardware and the deployment.',
  },
  {
    q: 'Do we need to change our code?',
    a: 'Your task becomes a function from an input record to an output record, over standard input and output, in any language. The supervisor reads each input once and runs three replicas of the task. It needs a known-answer test for the task. A check tool tells you whether the task is deterministic, and a wrapper runs an existing program once per cycle without a code change.',
  },
];
---

<Base
  crumbs={crumbs}
  faq={faq}
  ld={{
    software: {
      name: 'Mru Field',
      operatingSystem: 'Linux on ARM64, 32-bit ARM and x86_64',
      category: 'Fault-tolerance software for remote equipment',
    },
  }}
  active="field"
  request={{ interest: 'field', heading: 'Tell us what you run, and where.' }}
>
  <section class="wrap hero" style="padding-bottom: 56px">
    <Breadcrumbs items={crumbs} />
    <div class="hero-grid" style="margin-top: 40px">
      <div class="stack-m">
        <span class="eyebrow">Mru Field · Earth</span>
        <h1 class="h1">Mru Field: fault tolerance for hard-to-reach systems.</h1>
      </div>
      <div class="stack-m">
        <p class="lede">
          Mru Field runs your task as three replicas on one processor, the one already in your enclosure. Each cycle it
          reads the input once, hands the same bytes to every replica, and decides which result to trust. As replicas
          fail, it moves from voting to comparing to self-checking, and keeps delivering checked results until none are
          left. A second processor over a link is planned.
        </p>
        <p class="soft small">
          Status: version 0.1.0, built and tested on the bench on general-purpose processors, not yet on a board in the
          field. The decision core has run once in orbit.
        </p>
        <div class="row">
          <a class="btn" href="#request">
            Get in touch
          </a>
          <a class="btn ghost" href="/use-cases/">
            Use cases
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap">
    <figure class="plate">
      <div class="ph wide">
        <PlateImage photo={photo('02')} alt="A spar buoy in rough open ocean" />
      </div>
      <figcaption>
        <span class="cap">Air-sea interaction spar buoy deployed in rough open ocean</span>
        <span class="cr">{creditLine(photo('02'))}</span>
      </figcaption>
    </figure>
  </section>

  <section class="wrap section">
    <div class="split" style="margin-bottom: 56px">
      <div class="stack-m">
        <p class="eyebrow">What it does</p>
        <h2 class="h2">Four things, and nothing else.</h2>
      </div>
      <p class="lede">
        Fixed triple redundancy stops at the second replica failure. Mru Field continues with what is left, and tells
        your operators which mode it is in.
      </p>
    </div>
    <div class="cards four">
      <div class="note lead">
        <p class="tiny" style="margin: 0">
          01
        </p>
        <h3 class="h3">Steps down instead of stopping</h3>
        <p class="soft small">
          Vote on three, compare on two, self-check on one. It halts only when no replica is left.
        </p>
      </div>
      <div class="note">
        <p class="tiny" style="margin: 0">
          02
        </p>
        <h3 class="h3">Delivers only checked results</h3>
        <p class="soft small">
          A result leaves only if two replicas agree, or the last one gets the same answer twice. Kani proves this for
          every set of three replies to the decision function.
        </p>
      </div>
      <div class="note">
        <p class="tiny" style="margin: 0">
          03
        </p>
        <h3 class="h3">Diagnoses before it retires</h3>
        <p class="soft small">
          A replica outvoted 3 times in 200 cycles gets a known-answer test. It is retired only if it fails.
        </p>
      </div>
      <div class="note">
        <p class="tiny" style="margin: 0">
          04
        </p>
        <h3 class="h3">Logs every decision</h3>
        <p class="soft small">
          Mode changes, retirements, detected and delivered results, and every resume after a power cut, for your
          telemetry.
        </p>
      </div>
    </div>
  </section>

  <Seam life={80} label="Requirements and limits" />

  <section class="wrap section stack-l">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">Requirements and limits</p>
        <h2 class="h2">What it needs, and what it does not do.</h2>
      </div>
      <p class="lede">
        Your instrument and control code stays as it is. Mru Field sits between your task and the processor.
      </p>
    </div>
    <div class="tbl-box" tabindex="0">
      <table class="tbl">
        <tbody>
          <tr>
            <td style="width: 30%">Processors</td>
            <td>
              One Linux processor. The supervisor runs three replicas of your task as processes on it, and still works
              with one, in self-check mode. Replicas on a second processor over a link are planned. Until then, a
              failure of the processor itself is not survived.
            </td>
          </tr>
          <tr>
            <td>Platforms today</td>
            <td>Linux on ARM64, 32-bit ARM and x86_64. Decision core also builds bare-metal for ARM Cortex-M.</td>
          </tr>
          <tr>
            <td>Footprint</td>
            <td>
              At most {t('flight.footprint.linux-x86_64')} per process over every bench run on three hosts,{' '}
              {t('flight.footprint.linux-aarch64')} on 64-bit ARM Linux. Static release binaries are 642 to 675 kB.
            </td>
          </tr>
          <tr>
            <td>Throughput cost</td>
            <td>
              Three computations per cycle while three replicas are alive. With two, a mismatch loses that result and
              costs a known-answer test on both. On the last one the task computes twice per cycle.
            </td>
          </tr>
          <tr>
            <td>Known limit</td>
            <td>
              On the last replica, only the periodic known-answer test, every 64 cycles by default, can catch a stuck
              fault. <a href="https://docs.mru.space/core/bench/#kat">Measured with the demo task</a>: every stuck
              result was caught, after {t('flight.kat_coverage.stuck.64.wrong_mean')} wrong results on average. The one
              test input saw {t('flight.kat_coverage.stuckbit.out.64')} of stuck-at bits in the result; the others keep
              delivering wrong results. Bit flips that hit both self-check runs alike are not caught.
            </td>
          </tr>
          <tr>
            <td>Inputs</td>
            <td>
              The supervisor reads each input record once, from a serial port, a file, a socket or a command, and hands
              the same bytes to every replica. Your task computes from that record and the state it is handed, and
              nothing else. Across processors, real sensor inputs would still need an agreement step, which Mru does not
              provide yet.
            </td>
          </tr>
          <tr>
            <td>Not for</td>
            <td>Certified safety functions. Protection systems keep their own certification.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="strata">
      <div class="stratum">
        <span class="lv">Yours</span>
        <h3>Instrument and control code</h3>
        <p>
          Your task: a function from an input record to an output record, in any language. Sampling and telemetry
          unchanged.
        </p>
      </div>
      <div class="stratum base">
        <span class="lv">Mru</span>
        <h3>Mru Field</h3>
        <p>
          Acquisition once, shrinking quorum, health record, known-answer tests, checkpoint and resume, decision log.
        </p>
      </div>
      <div class="stratum">
        <span class="lv">Yours</span>
        <h3>One Linux processor</h3>
        <p>The board already in the enclosure. A second processor over a link is planned.</p>
      </div>
    </div>
  </section>

  <Seam life={64} label="Where it applies" />

  <section class="wrap section">
    <div class="row" style="justify-content: space-between; margin-bottom: 32px">
      <h2 class="h2">Where it applies</h2>
      <a class="link-more" href="/use-cases/">
        See more use cases
      </a>
    </div>
    <div class="cards" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr))">
      <a class="tile" href="/use-cases/deep-sea-observatories/">
        <div class="ph">
          <PlateImage photo={photo('01')} alt="" />
        </div>
        <span class="k">
          <span>Ocean</span>
        </span>
        <h3>Deep-sea observatories</h3>
        <p>Batteries, a cable, and one service visit a year.</p>
      </a>
      <a class="tile" href="/use-cases/ocean-buoys/">
        <div class="ph">
          <PlateImage photo={photo('02')} alt="" />
        </div>
        <span class="k">
          <span>Ocean</span>
        </span>
        <h3>Ocean buoys and moorings</h3>
        <p>Years at sea between services, on solar power.</p>
      </a>
      <a class="tile" href="/use-cases/profiling-floats/">
        <div class="ph">
          <PlateImage photo={photo('03')} alt="" />
        </div>
        <span class="k">
          <span>Ocean</span>
        </span>
        <h3>Profiling floats and gliders</h3>
        <p>Deployed once, rarely recovered.</p>
      </a>
      <a class="tile" href="/use-cases/offshore-wind/">
        <div class="ph">
          <PlateImage photo={photo('05')} alt="" />
        </div>
        <span class="k">
          <span>Energy</span>
        </span>
        <h3>Offshore wind</h3>
        <p>Every repair needs a vessel and a weather window.</p>
      </a>
      <a class="tile" href="/use-cases/polar-stations/">
        <div class="ph">
          <PlateImage photo={photo('09')} alt="" />
        </div>
        <span class="k">
          <span>Research</span>
        </span>
        <h3>Polar stations</h3>
        <p>No access for months of the year.</p>
      </a>
      <a class="tile" href="/use-cases/satellite-iot/">
        <div class="ph">
          <PlateImage photo={photo('08')} alt="" />
        </div>
        <span class="k">
          <span>Infrastructure</span>
        </span>
        <h3>Satellite-linked devices</h3>
        <p>Small power budgets, links measured in bytes.</p>
      </a>
    </div>
  </section>

  <Seam life={48} label="How we work with you" />

  <section class="wrap section stack-l">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">How we work with you</p>
        <h2 class="h2">Simulate. Pilot. Then the fleet.</h2>
      </div>
      <p class="lede">Each step is small enough to stop after.</p>
    </div>
    <div class="path">
      <div class="stack-s">
        <p class="n">1 · Simulate</p>
        <h3 class="h3">Your hardware, modeled</h3>
        <p class="soft small">
          We model your processors, failure rates and deployment length, and show what each redundancy design returns
          over the whole life. You get the model and the data.
        </p>
      </div>
      <div class="stack-s">
        <p class="n">2 · Pilot</p>
        <h3 class="h3">One site, months unattended</h3>
        <p class="soft small">
          Mru Field on your own equipment, with the decision log in your telemetry. A pilot on a European ocean
          observatory node is proposed for 2027.
        </p>
      </div>
      <div class="stack-s">
        <p class="n">3 · Fleet</p>
        <h3 class="h3">License and support</h3>
        <p class="soft small">Annual license per site or fleet, with support.</p>
      </div>
    </div>
  </section>

  <section class="wrap section" style="padding-top: 0">
    <div class="split">
      <h2 class="h2">Questions</h2>
      <Faq items={faq} />
    </div>
  </section>
</Base>
