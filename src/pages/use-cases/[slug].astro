---
// One template, fifteen settings (canvas UseCase artboard).
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Seam from '../../components/Seam.astro';
import PlateImage from '../../components/PlateImage.astro';
import Tile from '../../components/Tile.astro';
import Faq from '../../components/Faq.astro';
import { creditLine } from '../../data/images';
import { USE_CASES, useCase } from '../../data/use-cases';

export function getStaticPaths() {
  return USE_CASES.map((c) => ({ params: { slug: c.slug } }));
}
const c = useCase(Astro.params.slug);
const rel = c.rel.map(useCase);
---

<Base
  active="usecases"
  request={{ interest: 'field', topic: c.name, heading: `Is Mru Field a fit for your ${c.lower}?` }}
>
  <section class="wrap" style="padding-top: 48px">
    <Breadcrumbs
      items={[
        { label: 'Mru', href: '/' },
        { label: 'Mru Field', href: '/field/' },
        { label: 'Use cases', href: '/use-cases/' },
        { label: c.name },
      ]}
    />
    <div class="hero-grid" style="margin-top: 40px; align-items: end">
      <div class="stack-m">
        <div class="row" style="gap: 10px">
          <span class="eyebrow">{c.kicker}</span><span class={c.status === 'Exploring' ? 'pill' : 'pill sig'}
            ><span class="dot"></span>{c.status}</span
          >
        </div>
        <h1 class="h1">{c.name}</h1>
      </div>
      <p class="h2" style="font-family: var(--display); margin: 0; color: var(--ink-soft); text-wrap: balance">{c.hook}</p>
    </div>
  </section>

  <section class="wrap" style="margin-top: 48px">
    <figure class="plate">
      <div class="ph wide">
        <span class="no">PL. {c.plate}</span><PlateImage
          photo={c.photo}
          alt={c.cap}
          loading="eager"
          sizes="(max-width: 1296px) 100vw, 1216px"
        />
      </div>
      <figcaption><span class="cap">{c.cap}</span><span class="cr">{creditLine(c.photo)}</span></figcaption>
    </figure>
  </section>

  <section class="wrap section">
    <div class="split">
      <div class="stack-l">
        {
          c.stats.map((s) => (
            <div class="stat sigtop">
              <div class="v">{s.v}<small>{s.u}</small></div>
              <p class="l">{s.l}</p>
              <p class="src">{s.src}</p>
            </div>
          ))
        }
        {
          c.stats.length === 0 && (
            <div class="stack-s">
              <p class="quote" style="font-size: 26px">
                &#8220;Capability is a depleting resource to be spent, not a fixed budget to be defended.&#8221;
              </p>
              <p class="quote-by">Whitepaper, §5</p>
            </div>
          )
        }
      </div>
      <div class="stack-m">
        <p class="lede" style="color: var(--ink)">{c.intro}</p>
        <p class="soft">
          Mru Field runs on the processors already in the equipment. When one fails and nobody can come, it continues on
          the ones left and delivers only results it can check. Status: decision core at TRL 3; first field pilot planned
          for 2027.
        </p>
      </div>
    </div>
  </section>

  <Seam life={70} label="What fails out there" />

  <section class="wrap section">
    <div class="cards" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr))">
      {
        c.failures.map((f) => (
          <div class="stack-s" style="border-top: 1px solid var(--rule-strong); padding-top: 16px">
            <p class="tiny" style="margin: 0">
              {f.n}
            </p>
            <h2 class="h3">{f.t}</h2>
            <p class="soft small">{f.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <Seam life={50} label="What Mru Field does" />

  <section class="wrap section stack-l">
    <div class="split">
      <h2 class="h2">Three computers. Then two. Then one, still working.</h2>
      <p class="lede">
        Most redundant systems stop when they lose their majority. Mru Field steps down instead, and says which mode it
        is in.
      </p>
    </div>
    <div class="path">
      <div class="stack-s">
        <p class="n">3 alive · vote</p>
        <div class="row" style="gap: 8px; margin: 12px 0">
          <span class="proc"><span class="lamp"></span>A</span><span class="proc"><span class="lamp"></span>B</span><span
            class="proc"><span class="lamp"></span>C</span
          >
        </div>
        <p>Three computers vote. One bad result is outvoted.</p>
      </div>
      <div class="stack-s">
        <p class="n">2 alive · compare</p>
        <div class="row" style="gap: 8px; margin: 12px 0">
          <span class="proc"><span class="lamp"></span>A</span><span class="proc"><span class="lamp"></span>B</span><span
            class="proc dead"><span class="lamp"></span>C</span
          >
        </div>
        <p>Two compare. A known-answer test finds the faulty one.</p>
      </div>
      <div class="stack-s">
        <p class="n">1 alive · self-check</p>
        <div class="row" style="gap: 8px; margin: 12px 0">
          <span class="proc"><span class="lamp"></span>A</span><span class="proc dead"><span class="lamp"></span>B</span
          ><span class="proc dead"><span class="lamp"></span>C</span>
        </div>
        <p>The last one checks its own work and {c.last}, at half speed.</p>
      </div>
    </div>
    <div class="fit">
      <div><p class="k">Power</p><p class="v">{c.fit.power}</p></div>
      <div><p class="k">Link</p><p class="v">{c.fit.link}</p></div>
      <div><p class="k">Visits</p><p class="v">{c.fit.visit}</p></div>
      <div><p class="k">Service life</p><p class="v">{c.fit.life}</p></div>
    </div>
  </section>

  <section class="wrap section" style="padding-top: 0">
    <div class="split">
      <h2 class="h2">Questions</h2>
      <Faq items={c.faq} />
    </div>
  </section>

  <section class="wrap section tight">
    <div class="row" style="justify-content: space-between; margin-bottom: 24px">
      <h2 class="h3">Related settings</h2><a class="link-more" href="/use-cases/">All use cases</a>
    </div>
    <div class="cards">
      {rel.map((r) => <Tile href={r.href} photo={r.photo} kicker={r.kicker} name={r.name} />)}
    </div>
  </section>
</Base>
