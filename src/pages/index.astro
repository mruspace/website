---
import Base from '../layouts/Base.astro';
import Seam from '../components/Seam.astro';
import PlateImage from '../components/PlateImage.astro';
import Mark from '../components/Mark.astro';
import Descent from '../components/Descent.astro';
import QuorumDemo from '../components/QuorumDemo.astro';
import { photo } from '../data/images';

// Home tiles, from the Home artboard.
const TILES = [
  { name: 'Deep-sea observatories', kicker: 'Ocean', href: '/use-cases/deep-sea-observatories/', plate: '01' },
  { name: 'Ocean buoys and moorings', kicker: 'Ocean', href: '/use-cases/ocean-buoys/', plate: '02' },
  { name: 'Profiling floats and gliders', kicker: 'Ocean', href: '/use-cases/profiling-floats/', plate: '03' },
  { name: 'Offshore wind', kicker: 'Energy', href: '/use-cases/offshore-wind/', plate: '05' },
  { name: 'Remote energy and grid', kicker: 'Energy', href: '/use-cases/remote-energy/', plate: '06' },
  { name: 'Satellite-linked devices', kicker: 'Infrastructure', href: '/use-cases/satellite-iot/', plate: '08' },
  { name: 'Polar stations', kicker: 'Research', href: '/use-cases/polar-stations/', plate: '09' },
  { name: 'Volcano and seismic stations', kicker: 'Research', href: '/use-cases/volcano-seismic/', plate: '13' },
];
---

<Base rootClass="glow" request={{ interest: 'field', heading: 'Is Mru worth a conversation? Tell us what you run.' }}>
  <!-- 1 · Hero -->
  <section class="wrap hero" aria-labelledby="h-hero">
    <Mark size={128} staticSize={112} gap={40} />
    <h1 id="h-hero" class="h-hero" style="max-width: 15ch">
      Systems that still run a thousand years after we&#39;re gone
    </h1>
    <div class="hero-grid" style="margin-top: 48px; align-items: start">
      <p class="eyebrow" style="padding-top: 8px">
        Fault-tolerant software · Earth and space
      </p>
      <div class="stack-m">
        <p class="lede" style="color: var(--ink)">
          Mru is software for computers that cannot be repaired in time: ocean observatories, offshore and remote sites,
          spacecraft. When processors fail, it keeps delivering checked results with the ones left, instead of stopping.
        </p>
        <div class="row">
          <a class="btn" href="/contact/">
            Request information
          </a>
          <a class="btn ghost" href="/how-it-works/">
            How it works
          </a>
        </div>
      </div>
    </div>
    <Descent style="margin-top: 80px" />
  </section>

  <!-- 2 · The problem -->
  <section class="wrap section" aria-labelledby="h-problem">
    <div class="split" style="margin-bottom: 56px">
      <div class="stack-m">
        <p class="eyebrow">
          <span class="n">01</span> · The problem
        </p>
        <h2 id="h-problem" class="h2">
          Redundancy assumes a repair crew.
        </h2>
      </div>
      <div class="stack-m">
        <p class="lede">
          Triple modular redundancy stops safely at the second failure and waits for someone to fix it. On equipment
          nobody can reach in time, that wait is the rest of the deployment, and the processor still working is wasted.
        </p>
        <p class="soft small">The cost of reaching the hardware is what makes this expensive:</p>
      </div>
    </div>
    <div class="cards four">
      <figure class="plate">
        <div class="ph tall">
          <span class="no">SPACE</span>
          <PlateImage photo={photo('20')} alt="Artist's concept of the Voyager spacecraft" />
        </div>
        <div class="stat" style="margin-top: 16px">
          <div class="v">
            49<small>years</small>
          </div>
          <p class="l">Voyager in flight, kept alive by a ground team. Its power drops about 4 W a year.</p>
          <p class="src">NASA JPL · Photo NASA/JPL, PD</p>
        </div>
      </figure>
      <figure class="plate">
        <div class="ph tall">
          <span class="no">DEEP OCEAN</span>
          <PlateImage photo={photo('01')} alt="A deep-sea observatory module on a hydrothermal vent" />
        </div>
        <div class="stat" style="margin-top: 16px">
          <div class="v">
            1<small>visit / year</small>
          </div>
          <p class="l">EMSO-Azores, on batteries at 1,700 m.</p>
          <p class="src">EMSO ERIC · Photo Ifremer, CC BY 4.0</p>
        </div>
      </figure>
      <figure class="plate">
        <div class="ph tall">
          <span class="no">OPEN OCEAN</span>
          <PlateImage photo={photo('03')} alt="An Argo profiling float at the sea surface" />
        </div>
        <div class="stat" style="margin-top: 16px">
          <div class="v">
            ~900<small>/ year</small>
          </div>
          <p class="l">Argo floats replaced, about $40,000 each.</p>
          <p class="src">Argo Program · Photo Ifremer, CC BY 4.0</p>
        </div>
      </figure>
      <figure class="plate">
        <div class="ph tall">
          <span class="no">OFFSHORE</span>
          <PlateImage photo={photo('05')} alt="Heavy seas around offshore wind turbines" />
        </div>
        <div class="stat" style="margin-top: 16px">
          <div class="v">
            ~$40k<small>/ day</small>
          </div>
          <p class="l">For the vessel that services an offshore wind farm.</p>
          <p class="src">£30k · BVG Associates, 2025 · Photo US DOE, PD</p>
        </div>
      </figure>
    </div>
  </section>

  <Seam life={84} label="Mechanism" />

  <!-- 3 · Mechanism, interactive -->
  <section class="wrap section" aria-labelledby="h-how">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">
          <span class="n">02</span> · Mechanism
        </p>
        <h2 id="h-how" class="h2">
          Vote on three. Compare on two. Self-check on one.
        </h2>
        <p class="soft">
          While two or more processors are alive, Mru decides exactly as fixed TMR does. It differs only after TMR has
          stopped: the last processor computes twice and delivers a result only when both runs match. Remove a processor
          to compare.
        </p>
        <a class="link-more" href="https://docs.mru.space/concepts/shrinking-quorum/">
          The full rule, in the docs
        </a>
      </div>
      <QuorumDemo />
    </div>
  </section>

  <Seam life={70} label="Evidence" />

  <!-- 4 · Evidence -->
  <section class="wrap section" aria-labelledby="h-proof">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">
          <span class="n">03</span> · Evidence
        </p>
        <h2 id="h-proof" class="h2">
          1.34× the useful work of fixed TMR, on the same hardware.
        </h2>
        <p class="soft">
          Dusk, our open-source Monte Carlo: 10,000 missions on processors that fail and are never repaired. Every
          policy sees the same fault history.
        </p>
      </div>
      <div class="stack-l">
        <div class="bars">
          <p class="tiny" style="margin: 0">
            Mean useful years per mission
          </p>
          <div class="barrow">
            <span class="lab">Fixed TMR</span>
            <span class="track">
              <span class="fill" style="width: 47%"></span>
            </span>
            <span class="num">99.0</span>
          </div>
          <div class="barrow">
            <span class="lab">One computer, spares</span>
            <span class="track">
              <span class="fill a" style="width: 39.5%"></span>
            </span>
            <span class="num">83.1</span>
          </div>
          <div class="barrow">
            <span class="lab" style="color: var(--signal)">
              Mru
            </span>
            <span class="track">
              <span class="fill s" style="width: 63%"></span>
            </span>
            <span class="num" style="color: var(--signal)">
              132.6
            </span>
          </div>
        </div>
        <div class="tbl-box" tabindex="0">
          <table class="tbl">
            <tbody>
              <tr>
                <td>Gain over fixed TMR</td>
                <td class="m">1.34× (95% CI 1.33–1.35)</td>
              </tr>
              <tr>
                <td>Missions where Mru delivered less than TMR</td>
                <td class="m">0 of 10,000</td>
              </tr>
              <tr>
                <td>Gain across the sensitivity sweep</td>
                <td class="m">1.11× to 1.68×</td>
              </tr>
              <tr>
                <td>Cost: wrong results on the last processor</td>
                <td class="m">0.246 days / mission</td>
              </tr>
              <tr>
                <td>TMR wins only if one wrong result costs more than</td>
                <td class="m">136 years of work</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="tiny">
          Limits: parameters are illustrative, not calibrated to flight data. Power and thermal limits are not modelled.
          Field data is the next step. <a href="/research/dusk-results/">Full results and method</a>
        </p>
      </div>
    </div>
  </section>

  <Seam life={56} label="Where it applies" />

  <!-- 5 · Where it applies -->
  <section class="wrap section" aria-labelledby="h-where">
    <div class="split" style="margin-bottom: 56px">
      <div class="stack-m">
        <p class="eyebrow">
          <span class="n">04</span> · Where it applies
        </p>
        <h2 id="h-where" class="h2">
          Unattended equipment on Earth, first.
        </h2>
      </div>
      <div class="stack-m">
        <p class="lede">
          Mru fits when three things are true: the equipment has two or more processors, it must run unattended for
          months or longer, and a repair visit is slow, costly or impossible.
        </p>
        <a class="link-more" href="/use-cases/">
          All fifteen settings
        </a>
      </div>
    </div>
    <div class="cards four">
      {TILES.map((t) => (
        <a class="tile" href={t.href}>
          <div class="ph">
            <PlateImage
              photo={photo(t.plate)}
              alt=""
              sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 300px"
            />
          </div>
          <span class="k">
            <span>{t.kicker}</span>
            <span>PL. {t.plate}</span>
          </span>
          <h3>{t.name}</h3>
        </a>
      ))}
    </div>
  </section>

  <Seam life={42} label="Maturity" />

  <!-- 6 · What exists today -->
  <section class="wrap section stack-l" aria-labelledby="h-today">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">
          <span class="n">05</span> · Maturity
        </p>
        <h2 id="h-today" class="h2">
          What exists today, and what does not.
        </h2>
      </div>
      <p class="lede">
        Everything below is public. Nothing has run unattended in the field yet. That is the next step.
      </p>
    </div>
    <div class="tbl-box" tabindex="0">
      <table class="tbl">
        <thead>
          <tr>
            <th>Item</th>
            <th>What it is</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <a href="/research/">Whitepaper</a>
            </td>
            <td>Architecture and the Degradation-First Principle. doi:10.5281/zenodo.20579438</td>
            <td class="m">Published · May 2026</td>
          </tr>
          <tr>
            <td>
              <a href="/research/dusk-results/">Dusk</a>
            </td>
            <td>Monte Carlo of redundancy policies, 10,000 missions</td>
            <td class="m">Open source · TRL 3–4</td>
          </tr>
          <tr>
            <td>
              <a href="https://docs.mru.space/core/quorum-crate/">Decision core</a>
            </td>
            <td>
              Rust, <code>no_std</code>, no allocation, 4 Kani proofs, Cortex-M build
            </td>
            <td class="m">Open source · TRL 3</td>
          </tr>
          <tr>
            <td>
              <a href="https://docs.mru.space/core/quorum-cli/">Fault-injection demo</a>
            </td>
            <td>Three real processes; kill, hang, stuck and bit-flip faults; static ARM binaries</td>
            <td class="m">Open source · v0.1.1</td>
          </tr>
          <tr>
            <td>F&#180; components</td>
            <td>The core wrapped for NASA JPL's flight software framework</td>
            <td class="m">Designed · next</td>
          </tr>
          <tr>
            <td>OPS-SAT experiment</td>
            <td>Real radiation upsets on an ESA satellite</td>
            <td class="m">Next</td>
          </tr>
          <tr class="hl">
            <td>Mru Field pilot</td>
            <td>Months unattended on ocean equipment in the Azores</td>
            <td class="m">Planned 2027 · TRL 6 goal</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <Seam life={28} label="Products" />

  <!-- 7 · Products and path -->
  <section class="wrap section stack-l" aria-labelledby="h-path">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">
          <span class="n">06</span> · Products
        </p>
        <h2 id="h-path" class="h2">
          Ship on Earth. Prove it. Then fly.
        </h2>
      </div>
      <p class="lede">
        The same core runs in both products. Field data on Earth comes first, because it is the evidence a flight
        programme will ask for.
      </p>
    </div>
    <div class="cards two">
      <a class="card lead" href="/field/" style="text-decoration: none">
        <p class="k" style="color: var(--signal)">
          Earth · first
        </p>
        <h3 class="h2" style="margin-top: 12px">
          Mru Field
        </h3>
        <p class="soft" style="margin-top: 12px">
          For unattended equipment on Earth: ocean observatories, buoys, offshore and remote sites. Annual licence per
          site or fleet, with support.
        </p>
        <span class="link-more">Mru Field</span>
      </a>
      <a class="card" href="/flight/" style="text-decoration: none">
        <p class="k">Space · next</p>
        <h3 class="h2" style="margin-top: 12px">
          Mru Flight
        </h3>
        <p class="soft" style="margin-top: 12px">
          Onboard software for spacecraft, built on NASA JPL's F&#180;. Per mission, with support and
          qualification evidence.
        </p>
        <span class="link-more">Mru Flight</span>
      </a>
    </div>
    <p class="tiny">
      Open core: the design, the decision core and the simulator are public under Apache 2.0. We sell integration,
      support, qualification and simulation of your own hardware.
    </p>
  </section>
</Base>
