---
import Base from '../layouts/Base.astro';
import Seam from '../components/Seam.astro';
import PlateImage from '../components/PlateImage.astro';
import Descent from '../components/Descent.astro';
import QuorumDemo from '../components/QuorumDemo.astro';
import NewsBar from '../components/NewsBar.astro';
import { photo } from '../data/images';
import { claim, t, ci } from '../data/claims';

// Evidence bars: mean useful years per mission, from Dusk via claims.json.
// The track is 210 years wide, as before (99.0 years filled 47%).
const BARS = [
  { label: 'Fixed TMR', id: 'dusk.useful_years.tmr', cls: 'fill' },
  { label: 'Standby simplex', id: 'dusk.useful_years.simplex', cls: 'fill a' },
  { label: 'Cold standby, spares aging 0.1', id: 'dusk.useful_years.cold_01', cls: 'fill a' },
  { label: 'TMR, unchecked fallback', id: 'dusk.useful_years.unchecked', cls: 'fill a' },
  { label: 'Mru', id: 'dusk.useful_years.shrink', cls: 'fill s', mru: true },
].map((b) => ({ ...b, years: t(b.id), width: `${((Number(claim(b.id).value) / 210) * 100).toFixed(1)}%` }));

// Home tiles, from the Home artboard.
const TILES = [
  { name: 'Deep-sea observatories', kicker: 'Ocean', href: '/use-cases/deep-sea-observatories/', plate: '01' },
  { name: 'Ocean buoys and moorings', kicker: 'Ocean', href: '/use-cases/ocean-buoys/', plate: '02' },
  { name: 'Profiling floats and gliders', kicker: 'Ocean', href: '/use-cases/profiling-floats/', plate: '03' },
  { name: 'Offshore wind', kicker: 'Energy', href: '/use-cases/offshore-wind/', plate: '05' },
  { name: 'Remote energy and grid', kicker: 'Energy', href: '/use-cases/remote-energy/', plate: '06' },
  { name: 'Satellite-linked devices', kicker: 'Infrastructure', href: '/use-cases/satellite-iot/', plate: '08' },
  { name: 'Polar stations', kicker: 'Research', href: '/use-cases/polar-stations/', plate: '09' },
  { name: 'Volcano and seismic stations', kicker: 'Research', href: '/use-cases/volcano-seismic/', plate: '13' },
];
---

<Base rootClass="glow" request={{ interest: 'field' }}>
  <NewsBar slot="top" href="/research/flight-orbit/">
    Mru Flight ran in orbit on ESA's OPS-SAT satellite
  </NewsBar>
  <!-- 1 · Hero -->
  <section class="wrap hero" aria-labelledby="h-hero">
    <h1 id="h-hero" class="h-hero" style="max-width: 22ch">
      Systems that still run a thousand years after we&#39;re gone
    </h1>
    <div class="stack-m" style="margin-top: 48px; max-width: 720px">
      <p class="lede" style="color: var(--ink)">
        Mru is software for systems that cannot be easily maintained or repaired: ocean observatories, offshore and
        remote sites, spacecraft. When processors fail, it keeps delivering checked results with the ones left, instead
        of stopping.
      </p>
      <div class="row">
        <a class="btn hero-contact" href="/contact/">
          Get in touch
        </a>
        <a class="btn ghost" href="/architecture/">
          Learn more<span class="sr-only"> about how Mru works</span>
        </a>
      </div>
    </div>
    <Descent style="margin-top: 80px" />
  </section>

  <!-- 2 · The problem -->
  <section class="wrap section" aria-labelledby="h-problem">
    <div class="split" style="margin-bottom: 56px">
      <div class="stack-m">
        <p class="eyebrow">The problem</p>
        <h2 id="h-problem" class="h2">
          Most fault tolerance assumes someone can step in eventually.
        </h2>
      </div>
      <div class="stack-m">
        <p class="lede">
          Spacecraft mostly fly two strings of radiation-hardened processors, with error-correcting memory, watchdogs
          and autonomous fault protection. When a part fails, the system makes itself safe and people decide what comes
          next. On equipment nobody can reach in time, that wait can be the rest of the deployment.
        </p>
        <p class="soft">
          Stepping down from three replicas to two to one is{' '}
          <a href="https://docs.mru.space/concepts/prior-art/">not new</a>: the Space Shuttle&#39;s computers did it.
          Mru adds three things. It degrades on its own, with no ground team. Its decision core is small and verified.
          Its trade data is public.
        </p>
        <p class="soft">
          What it costs to reach the hardware. Batteries, sensors and mechanical work cause most of these visits, not
          processor failure, and Mru does not remove them. Mru keeps the replicas that are left doing checked work
          between visits. It needs one Linux processor. A second processor, planned, is what survives the failure of the
          first.
        </p>
      </div>
    </div>
    <div class="cards four">
      <figure class="plate">
        <div class="ph tall">
          <span class="no">SPACE</span>
          <PlateImage photo={photo('20')} alt="Artist's concept of the Voyager spacecraft" />
        </div>
        <div class="stat" style="margin-top: 16px">
          <div class="v">
            49<small>years</small>
          </div>
          <p class="l">
            Voyager in flight, with a ground team the whole time. Its limit is power, about 4 W less each year. Mru does
            not address power today.
          </p>
          <p class="src">
            <a href="https://www.jpl.nasa.gov/news/nasa-turns-off-two-voyager-science-instruments-to-extend-mission/">
              NASA JPL, 2025
            </a>{' '}
            · Photo NASA/JPL, PD
          </p>
        </div>
      </figure>
      <figure class="plate">
        <div class="ph tall">
          <span class="no">DEEP OCEAN</span>
          <PlateImage photo={photo('01')} alt="A deep-sea observatory module on a hydrothermal vent" />
        </div>
        <div class="stat" style="margin-top: 16px">
          <div class="v">
            1<small>visit / year</small>
          </div>
          <p class="l">EMSO-Azores, on batteries at 1,700 m. A maintenance cruise reaches it once a year.</p>
          <p class="src">
            <a href="https://www.emso-fr.org/EMSO-Azores/Maintenance-cruises">EMSO-Azores cruises</a> · Photo Ifremer,
            CC BY 4.0
          </p>
        </div>
      </figure>
      <figure class="plate">
        <div class="ph tall">
          <span class="no">OPEN OCEAN</span>
          <PlateImage photo={photo('03')} alt="An Argo profiling float at the sea surface" />
        </div>
        <div class="stat" style="margin-top: 16px">
          <div class="v">
            600<small>/ year</small>
          </div>
          <p class="l">
            New Argo floats needed each year to hold the array. Each costs about $20,000, about double once deployed.
            Batteries set a float&#39;s life at 3 to 5 years.
          </p>
          <p class="src">
            <a href="https://argo.ucsd.edu/faq/">Argo Program FAQ</a> · Photo Ifremer, CC BY 4.0
          </p>
        </div>
      </figure>
      <figure class="plate">
        <div class="ph tall">
          <span class="no">OFFSHORE</span>
          <PlateImage photo={photo('05')} alt="Heavy seas around offshore wind turbines" />
        </div>
        <div class="stat" style="margin-top: 16px">
          <div class="v">
            $40k<small>/ day</small>
          </div>
          <p class="l">
            About the charter day rate for a service operation vessel at an offshore wind farm, excluding fuel.
          </p>
          <p class="src">
            £30k ·{' '}
            <a href="https://guidetofloatingoffshorewind.com/guide/o-operations-and-maintenance/o-4-offshore-vessels-and-logistics/o-4-2-service-operation-vessels/">
              BVG Associates
            </a>{' '}
            · Photo US DOE, PD
          </p>
        </div>
      </figure>
    </div>
  </section>

  <Seam life={84} label="Mechanism" />

  <!-- 3 · Mechanism, interactive -->
  <section class="wrap section" aria-labelledby="h-how">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">Mechanism</p>
        <h2 id="h-how" class="h2">
          Vote on three. Compare on two. Self-check on one.
        </h2>
        <p class="soft">
          On three replicas, Mru votes as fixed TMR does. On two, a mismatch triggers a known-answer test that can find
          and retire the bad replica, where fixed TMR stays in disagreement. On one, the last processor computes twice
          and delivers a result only when both runs match. Remove a processor to compare.
        </p>
        <a class="link-more" href="https://docs.mru.space/concepts/shrinking-quorum/">
          The full rule, in the docs
        </a>
      </div>
      <QuorumDemo />
    </div>
  </section>

  <Seam life={70} label="Evidence" />

  <!-- 4 · Evidence -->
  <section class="wrap section" aria-labelledby="h-proof">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">Evidence</p>
        <h2 id="h-proof" class="h2">
          {t('dusk.work_vs_tmr')} the useful work of fixed TMR, on the same hardware.
        </h2>
        <p class="soft">
          Dusk, our open-source Monte Carlo: {t('dusk.runs')} missions on processors that fail and are never repaired.
          Every policy sees the same fault history. This assumes no ground support after launch. With{' '}
          <a href="/research/dusk-results/#when-the-ground-can-help">ground support that never ends</a>, the gain is{' '}
          {t('dusk.ground.never')}.
        </p>
        <p class="soft">
          Against autonomous baselines the result is mixed. Cold standby does more work when an unpowered spare ages at
          less than {t('dusk.cold.crossing')} of the powered rate. A fallback with no self-check does more work, with
          far more wrong results.
        </p>
        <p class="soft">
          <a href="/research/flight-orbit/">In orbit on ESA&#39;s OPS-SAT PRETTY</a>, 18 October 2026: 2,745 correct
          results and 0 wrong over 5,250 ticks, where fixed triple redundancy stopped at 239.
        </p>
      </div>
      <div class="stack-l">
        <div class="bars">
          <p class="tiny" style="margin: 0">
            Mean useful years per mission
          </p>
          {BARS.map((b) => (
            <div class="barrow">
              <span class="lab" style={b.mru ? 'color: var(--signal)' : undefined}>
                {b.label}
              </span>
              <span class="track">
                <span class={b.cls} style={`width: ${b.width}`} />
              </span>
              <span class="num" style={b.mru ? 'color: var(--signal)' : undefined}>
                {b.years}
              </span>
            </div>
          ))}
        </div>
        <div class="tbl-box" tabindex="0">
          <table class="tbl">
            <tbody>
              <tr>
                <td>Against fixed TMR</td>
                <td class="m">
                  {t('dusk.work_vs_tmr')} (95% CI {ci('dusk.work_vs_tmr')})
                </td>
              </tr>
              <tr>
                <td>Against cold standby, three strings, spares aging 0.1 to 1.0</td>
                <td class="m">
                  {t('dusk.work_vs_cold.01')} to {t('dusk.work_vs_cold.10')}
                </td>
              </tr>
              <tr>
                <td>Against TMR with an unchecked fallback</td>
                <td class="m">
                  {t('dusk.work_vs_unchecked')} of the work, {t('dusk.wrong_vs_unchecked')} of the wrong results
                </td>
              </tr>
              <tr>
                <td>Missions with at least one wrong result</td>
                <td class="m">
                  Mru {t('dusk.risk.shrink')}, fixed TMR {t('dusk.risk.tmr')}, cold standby {t('dusk.risk.cold_10')} to{' '}
                  {t('dusk.risk.cold_01')}
                </td>
              </tr>
              <tr>
                <td>Fixed TMR wins only if one wrong result costs more than</td>
                <td class="m">
                  {t('dusk.break_even_years')} years of work (95% CI {ci('dusk.break_even_years')})
                </td>
              </tr>
              <tr>
                <td>Against fixed TMR, across the sensitivity sweep</td>
                <td class="m">{t('dusk.sweep.range')}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="tiny">
          Limits: parameters are illustrative, not calibrated to flight data. Power and thermal limits are not modeled.
          The aging rate of an unpowered spare is not known, so it is swept.
        </p>
        <a class="link-more" href="/research/dusk-results/">
          Full results and method
        </a>
      </div>
    </div>
  </section>

  <Seam life={56} label="Where it applies" />

  <!-- 5 · Where it applies -->
  <section class="wrap section" aria-labelledby="h-where">
    <div class="split" style="margin-bottom: 56px">
      <div class="stack-m">
        <p class="eyebrow">Where it applies</p>
        <h2 id="h-where" class="h2">
          Hard-to-reach systems on Earth.
        </h2>
      </div>
      <div class="stack-m">
        <p class="lede">
          Mru fits when three things are true: the equipment has a Linux processor with room to run your task three
          times, it must run unattended for months or longer, and a repair visit is slow, costly or impossible.
        </p>
        <a class="link-more" href="/use-cases/">
          See more use cases
        </a>
      </div>
    </div>
    <div class="cards four">
      {TILES.map((t) => (
        <a class="tile" href={t.href}>
          <div class="ph">
            <PlateImage
              photo={photo(t.plate)}
              alt=""
              sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 300px"
            />
          </div>
          <span class="k">
            <span>{t.kicker}</span>
          </span>
          <h3>{t.name}</h3>
        </a>
      ))}
    </div>
  </section>

  <Seam life={42} label="Products" />

  <!-- 7 · Products and path -->
  <section class="wrap section stack-l" aria-labelledby="h-path">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">Products</p>
        <h2 id="h-path" class="h2">
          One core, on Earth and in space.
        </h2>
      </div>
      <p class="lede">The same core runs in both products.</p>
    </div>
    <div class="cards two">
      <a class="card lead" href="/field/" style="text-decoration: none">
        <p class="k" style="color: var(--signal)">
          Earth
        </p>
        <h3 class="h2" style="margin-top: 12px">
          Mru Field
        </h3>
        <p class="soft" style="margin-top: 12px">
          For hard-to-reach systems on Earth: ocean observatories, buoys, offshore and remote sites. Annual license per
          site or fleet, with support.
        </p>
        <span class="link-more">Mru Field</span>
      </a>
      <a class="card" href="/flight/" style="text-decoration: none">
        <p class="k">Space</p>
        <h3 class="h2" style="margin-top: 12px">
          Mru Flight
        </h3>
        <p class="soft" style="margin-top: 12px">
          Onboard software for spacecraft, built on NASA JPL&#39;s F&#180;. v0.3.1 has run once in orbit, on ESA&#39;s
          OPS-SAT PRETTY. Per mission, with support. Qualification is planned; no qualification evidence exists yet.
        </p>
        <span class="link-more">Mru Flight</span>
      </a>
    </div>
    <p class="tiny">
      Open core: the decision core and the simulator are public under Apache 2.0, and the whitepaper under CC BY 4.0. We
      sell integration, support and simulation of your own hardware.
    </p>
  </section>
</Base>
