---
import Base from '../../layouts/Base.astro';
import Chart from '../../components/Chart.astro';
import Seam from '../../components/Seam.astro';
import PlateImage from '../../components/PlateImage.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { photo, creditLine } from '../../data/images';
import { t } from '../../data/claims';

const crumbs = [{ label: 'Mru', href: '/' }, { label: 'Mru Flight' }];
const faq = [
  {
    q: 'Do we need new flight hardware?',
    a: 'No. Mru Flight is software for the processors you already fly, starting with F´, then other flight software frameworks. It needs two or more processors that can run the same task at the same time, and each one costs power.',
  },
  {
    q: 'What does it cost us in throughput?',
    a: 'Nothing while three processors are alive. With two, a mismatch loses that result and costs a known-answer test on both. On the last one, self-check runs at half speed, because it does every computation twice.',
  },
  {
    q: 'What is the risk?',
    a: 'On one processor, a stuck fault is caught by a periodic known-answer test. Until then, a few wrong results can get out. We measure and publish that trade.',
  },
  {
    q: 'How is it priced?',
    a: 'Per mission, with support. No qualification evidence exists yet; the qualification path below says what does. We discuss terms once we know the mission and its hardware.',
  },
];
---

<Base
  crumbs={crumbs}
  faq={faq}
  ld={{
    software: {
      name: 'Mru Flight',
      operatingSystem: 'Linux, macOS; the decision core also builds for bare-metal ARM Cortex-M (no_std)',
      category: 'Onboard flight software',
    },
  }}
  active="flight"
  request={{ interest: 'flight', heading: 'Tell us about your mission.' }}
>
  <section class="wrap hero" style="padding-bottom: 56px">
    <Breadcrumbs items={crumbs} />
    <div class="hero-grid" style="margin-top: 40px">
      <div class="stack-m">
        <span class="eyebrow">Mru Flight · Space</span>
        <h1 class="h1">Mru Flight: fault tolerance for spacecraft out of reach.</h1>
      </div>
      <div class="stack-m">
        <p class="lede">
          Onboard software for the processors you already fly. A small Rust decision core, checked with the Kani model
          checker, as components for NASA JPL's F&#180; framework, with a C interface for other flight software
          frameworks.
        </p>
        <div class="row">
          <a class="btn" href="#request">
            Get in touch
          </a>
          <a class="btn ghost" href="/research/flight-measured/">
            Read the release
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap">
    <figure class="plate">
      <div class="ph wide">
        <PlateImage photo={photo('16')} alt="Two CubeSats released from the International Space Station above Earth" />
      </div>
      <figcaption>
        <span class="cap">Two CubeSats released from the ISS above Earth's limb</span>
        <span class="cr">{creditLine(photo('16'))}</span>
      </figcaption>
    </figure>
  </section>

  <section class="wrap section">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">The problem</p>
        <h2 class="h2">Fixed TMR stops at the second failure.</h2>
      </div>
      <div class="stack-m">
        <p class="lede">
          Fixed triple modular redundancy (TMR) votes on three processors and stops when it can no longer form a
          majority. Most spacecraft fly two strings with autonomous fault protection instead: it makes the spacecraft
          safe and waits for the ground. Mru Flight is for missions where the ground cannot step in, or not in time.
        </p>
        <p class="soft">
          It keeps going on its own: vote on three, compare on two, self-check on one. Given the same replies from two
          or more replicas, each decision has the same outcome as fixed TMR&#39;s. On one replica, it keeps working.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap">
    <figure class="figure" style="margin: 0">
      <Chart
        name="flight-correct"
        alt="Correct results over 20,000 ticks. Fixed TMR stops at 8,993. The shrinking quorum reaches 14,490."
      />
      <figcaption class="cap">
        One run, same seed and faults: one replica stuck at tick 4,000, another dead at 9,000. Fixed TMR: 8,993 correct
        results. Mru Flight: 14,490.
      </figcaption>
    </figure>
  </section>

  <section class="wrap section">
    <div class="cards">
      <div class="note lead">
        <p class="tiny" style="margin: 0">
          Proved, per decision
        </p>
        <h3 class="h3">Same outcome as fixed TMR on two or more</h3>
        <p class="soft small">
          Kani proves that, with two or more replicas alive, <code>decide()</code> gives the same outcome under both
          policies, for every set of three replies.{' '}
          <a href="https://github.com/mruspace/flight/blob/v0.3.1/quorum/src/lib.rs#L331">The proof</a>
        </p>
      </div>
      <div class="note">
        <p class="tiny" style="margin: 0">
          Proved, per decision
        </p>
        <h3 class="h3">Only agreed results</h3>
        <p class="soft small">
          A delivered value came from two agreeing replicas, or from both runs of the last replica&#39;s self-check.
          Kani proves it for every set of three replies to <code>decide()</code>.{' '}
          <a href="https://github.com/mruspace/flight/blob/v0.3.1/quorum/src/lib.rs#L362">The proof</a>
        </p>
      </div>
      <div class="note">
        <p class="tiny" style="margin: 0">
          Tested, per run
        </p>
        <h3 class="h3">Never less than fixed TMR</h3>
        <p class="soft small">
          Over a whole run this is tested, not proved: ten seeds in the scenario tests and {t('flight.bench.pairs')} run
          pairs on the bench. The proof does not carry over, because Mru retires replicas that fixed TMR keeps.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section" style="padding-top: 0">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">Requirements and limits</p>
        <h2 class="h2">What it needs, and what it does not do.</h2>
      </div>
      <div class="tbl-box" tabindex="0">
        <table class="tbl">
          <tbody>
            <tr>
              <td style="width: 32%">Processors</td>
              <td>
                Three replicas of the same task, on two or more processors. Continues on two, then one. Each processor
                costs power.
              </td>
            </tr>
            <tr>
              <td>Targets today</td>
              <td>
                Decision core: <code>no_std</code>, built in CI for bare-metal ARM Cortex-M, not yet run on one. Demo
                and bench: static Linux binaries for 64-bit and 32-bit ARM and x86_64, tested in CI, natively and under
                emulation.
              </td>
            </tr>
            <tr>
              <td>Framework</td>
              <td>
                Four F&#180; v4.4.1 components, built and tested: RedundancyManager, HealthRegistry, ReplicaHost and the
                test-only FaultInjector. Not yet run on flight hardware.
              </td>
            </tr>
            <tr>
              <td>Throughput cost</td>
              <td>
                None with three replicas alive. With two, a mismatch loses that result and costs a known-answer test on
                both. Half rate on the last one.
              </td>
            </tr>
            <tr>
              <td>Footprint</td>
              <td>
                At most {t('flight.footprint.linux-x86_64')} per process over every bench run on three hosts,{' '}
                {t('flight.footprint.linux-aarch64')} on 64-bit ARM Linux. The core is <code>no_std</code>, allocates
                nothing and has no dependencies.
              </td>
            </tr>
            <tr>
              <td>Command path</td>
              <td>
                Self-check on one replica is for data products, not spacecraft commands, unless the mission adds its own
                command safety layer. Integrators can gate commands on <code>Verdict.mode</code>.{' '}
                <a href="https://docs.mru.space/core/quorum-crate/#gate">Example</a>
              </td>
            </tr>
            <tr>
              <td>Input agreement</td>
              <td>
                The demo gives every replica the same input, derived from the tick. Real sensor inputs need an agreement
                step between replicas, which Mru does not provide yet.
              </td>
            </tr>
            <tr>
              <td>Known limit</td>
              <td>
                On the last replica, only the periodic known-answer test, every 64 ticks by default, can catch a stuck
                fault. Measured with the demo task: every stuck result was caught, after{' '}
                {t('flight.kat_coverage.stuck.64.wrong_mean')} wrong results on average. The one test input saw{' '}
                {t('flight.kat_coverage.stuckbit.out.64')} of stuck-at bits in the result; the others keep delivering
                wrong results. Bit flips that hit both self-check runs alike are not caught.{' '}
                <a href="https://docs.mru.space/core/bench/#kat">Coverage data</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="wrap section" style="padding-top: 0" id="qualification">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">Qualification path</p>
        <h2 class="h2">No qualification evidence exists yet.</h2>
        <p class="soft">
          Mru makes no compliance claim. These are the standards a flight program would hold it to, and what exists
          today that could feed them.
        </p>
        <a class="link-more" href="https://docs.mru.space/concepts/qualification/">
          The full map, in the docs
        </a>
      </div>
      <div class="tbl-box" tabindex="0">
        <table class="tbl">
          <tbody>
            <tr>
              <td style="width: 32%">NASA</td>
              <td>
                NPR 7150.2, NASA Software Engineering Requirements. NASA-STD-8739.8, Software Assurance and Software
                Safety Standard.
              </td>
            </tr>
            <tr>
              <td>ESA</td>
              <td>
                ECSS-E-ST-40C, Space engineering: Software. ECSS-Q-ST-80C, Space product assurance: Software product
                assurance.
              </td>
            </tr>
            <tr>
              <td>What exists</td>
              <td>
                Unit tests, {t('flight.kani.total')} Kani proofs, CI on three operating systems and emulated ARM,
                scenario tests, a bench, and F&#180; unit and system tests.
              </td>
            </tr>
            <tr>
              <td>Not started</td>
              <td>
                Software classification, requirements traceability, independent verification and validation, structural
                coverage, and a qualification plan for the Rust toolchain (TODO).
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Seam life={60} label="Getting to orbit" />

  <section class="wrap section stack-l">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">Getting to orbit</p>
        <h2 class="h2">What exists, and what comes next.</h2>
      </div>
      <p class="lede">
        The decision core and its F&#180; components are built, tested and measured. Each next step adds real hardware,
        then flight.
      </p>
    </div>
    <div class="strata">
      <div class="stratum">
        <span class="lv">Now</span>
        <h3>Core, F&#180; components and bench</h3>
        <p>
          Rust core with Kani proofs, F&#180; components that give the demo&#39;s counts, a bench of three replica
          processes on general-purpose hosts, and resets survived. v0.3.1.
        </p>
      </div>
      <div class="stratum">
        <span class="lv">Next</span>
        <h3>Hardware in the loop</h3>
        <p>Target-class boards with injected faults: bit flips, resets, power cuts. The scripts are ready.</p>
      </div>
      <div class="stratum">
        <span class="lv">Then</span>
        <h3>F&#180; deployment</h3>
        <p>A full F&#180; deployment on those boards, with commands and telemetry from the ground.</p>
      </div>
      <div class="stratum base">
        <span class="lv">Orbit</span>
        <h3>In orbit</h3>
        <p>
          A flight experiment under injected faults, with the software's own radiation sensor logged. Registered with
          ESA's OPS-SAT Space Lab for OPS-SAT PRETTY in October 2026 (experiment exp4051). ESA's software environment
          test passed on 15 October 2026, and TU Graz's FlatSat test on the flight processor on 16 October 2026. Nothing
          has run on the satellite yet; the run in orbit is next.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section" style="padding-top: 0">
    <div class="split">
      <div class="stack-m">
        <p class="eyebrow">For</p>
        <h2 class="h2">Mission teams who can't send a technician.</h2>
      </div>
      <ul class="sig-list" style="font-size: 19px">
        <li>Smallsat and constellation operators</li>
        <li>Lunar and deep-space mission teams</li>
        <li>Agencies, primes, and rad-hard and FPGA vendors</li>
      </ul>
    </div>
  </section>

  <section class="wrap section" style="padding-top: 0">
    <div class="split">
      <h2 class="h2">Questions</h2>
      <Faq items={faq} />
    </div>
  </section>
</Base>
