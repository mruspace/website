---
// Where the Worker sends a plain form post (JS off). It reuses the
// "Request sent" card from the form, inside the Contact page hero.
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { SITE } from '../../../data/site';

const crumbs = [{ label: 'Mru', href: '/' }, { label: 'Get in touch', href: '/contact/' }, { label: 'Request sent' }];
---

<Base crumbs={crumbs}>
  <section class="wrap hero" style="padding-bottom: 128px">
    <Breadcrumbs items={crumbs} />
    <div class="hero-grid" style="margin-top: 40px">
      <h1 class="h1">Request sent</h1>
      <div class="sent stack-m" role="status">
        <p class="eyebrow" style="color: var(--signal)">
          <span class="dot" style="margin-right: 8px"></span>Request sent
        </p>
        <h2 class="h3">Thank you.</h2>
        <p class="soft small">We reply by email and will be in touch soon.</p>
        <div class="row">
          <a class="link-more" href="/use-cases/">
            Use cases
          </a>
          <a class="link-more" href={`${SITE.docsUrl}/`}>
            Docs
          </a>
          <a class="link-more" href="/research/">
            Research
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
