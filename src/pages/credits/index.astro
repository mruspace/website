---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlateImage from '../../components/PlateImage.astro';
import { PHOTOS } from '../../data/images';

const crumbs = [{ label: 'Mru', href: '/' }, { label: 'Company', href: '/company/' }, { label: 'Credits' }];
---

<Base crumbs={crumbs}>
  <section class="wrap hero" style="padding-bottom: 48px">
    <Breadcrumbs items={crumbs} />
    <div class="hero-grid" style="margin-top: 40px">
      <h1 class="h1">Credits</h1>
      <div class="stack-m">
        <p class="lede">Sources and licences for the photos on this site.</p>
        <p class="soft small">
          Changes: all photos are cropped and shown in greyscale, blended into the page. Adaptations of CC BY-SA photos
          are shared under the same licence. Charts are our own.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section" style="padding-top: 0">
    <div class="tbl-box" tabindex="0">
      <table class="tbl">
        <thead>
          <tr>
            <th>Photo</th>
            <th>Author</th>
            <th>Licence</th>
            <th>Source</th>
          </tr>
        </thead>
        <tbody>
          {PHOTOS.map((r) => (
            <tr>
              <td style="min-width: 320px">
                <div style="display: flex; gap: 16px; align-items: center">
                  <span class="plate" style="width: 96px; flex: none">
                    <span class="ph" style="display: block; aspect-ratio: 3 / 2">
                      <PlateImage photo={r} alt="" sizes="96px" />
                    </span>
                  </span>
                  <span>{r.caption}</span>
                </div>
              </td>
              <td>{r.author}</td>
              <td class="m">
                <a href={r.licenceUrl}>{r.licence}</a>
              </td>
              <td class="m">
                <a href={r.source}>Source &#8599;</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="tiny" style="margin-top: 32px">
      The Mru name and the Mru mark are trademarks of Binns Pte. Ltd. They are not covered by these licences.
    </p>
  </section>
</Base>
