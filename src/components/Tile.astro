---
// A use-case tile: plate photo, kicker, name, optional line.
import PlateImage from './PlateImage.astro';
import type { Photo } from '../data/images';

interface Props {
  href: string;
  photo: Photo;
  kicker: string;
  name: string;
  text?: string;
  sizes?: string;
}
const {
  href,
  photo,
  kicker,
  name,
  text,
  sizes = '(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 400px',
} = Astro.props;
---

<a class="tile" href={href}>
  <div class="ph">
    <PlateImage photo={photo} alt="" sizes={sizes} />
  </div>
  <span class="k">
    <span>{kicker}</span>
  </span>
  <h3>{name}</h3>
  {text && <p>{text}</p>}
</a>
