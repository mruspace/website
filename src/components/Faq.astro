---
// Questions as <details>. The FAQPage JSON-LD is built from the same items.
import type { Qa } from '../data/use-cases';
import { keepFPrime } from '../data/text';
interface Props {
  items: Qa[];
}
const { items } = Astro.props;
---

<div class="faq">
  {items.map((q) => (
    <details>
      <summary>{keepFPrime(q.q)}</summary>
      <p>{keepFPrime(q.a)}</p>
    </details>
  ))}
</div>
