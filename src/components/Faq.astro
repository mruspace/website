---
// Questions as <details>. The FAQPage JSON-LD is built from the same items.
import type { Qa } from '../data/use-cases';
interface Props {
  items: Qa[];
}
const { items } = Astro.props;
---

<div class="faq">
  {items.map((q) => (
    <details>
      <summary>{q.q}</summary>
      <p>{q.a}</p>
    </details>
  ))}
</div>
