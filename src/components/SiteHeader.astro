---
import Mark from './Mark.astro';
import { MAIN_NAV, type NavId } from '../data/nav';

interface Props {
  active?: NavId;
}
const { active = 'none' } = Astro.props;
---

<header class="mru part site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Mru home">
      <Mark alt="" />
      <span>Mru</span>
    </a>
    <nav class="nav" aria-label="Main">
      {MAIN_NAV.map((l) => (
        <a class:list={{ on: l.id === active }} href={l.href} aria-current={l.id === active ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
    <a class="btn small cta" href="/contact/">
      Get in touch
    </a>
    <details class="menu-toggle">
      <summary aria-label="Open menu">Menu</summary>
      <nav class="menu-panel" aria-label="Main, small screens">
        {MAIN_NAV.map((l) => (
          <a href={l.href} aria-current={l.id === active ? 'page' : undefined}>
            {l.label}
          </a>
        ))}
        <a href="/contact/">Get in touch</a>
      </nav>
    </details>
  </div>
</header>
