---
// The animated mark. The GIFs carry no alpha: light art multiplies on paper,
// dark art screens on ink (see README). No transform, filter, opacity or
// z-index may sit on this element or any ancestor, or the blend breaks.
// Both images are lazy: only the one the theme shows gets a layout box, so
// the other never downloads. Nothing stands in while the GIF loads: the
// space stays empty, then the animation shows. The GIFs are about 2 MB, so
// they fetch at low priority: the fonts and the hero text paint first.
// Reduced motion hides both and shows the SVG.
import MarkSvg from './MarkSvg.astro';

interface Props {
  size?: number;
  staticSize?: number;
  gap?: number;
  alt?: string;
}
const { size, staticSize, gap, alt = 'The Mru mark: a ring, a tilted orbit and an M' } = Astro.props;
// Inline sizes only where a page sets them, as on the canvas; otherwise the
// stylesheet sizes the mark (104 px, 88 px on phones).
const style = (s?: number) =>
  [s === undefined ? '' : `width: ${s}px; height: ${s}px`, gap === undefined ? '' : `margin-bottom: ${gap}px`]
    .filter(Boolean)
    .join('; ') || undefined;
---

<span class="mark-anim" style={style(size)}>
  <picture>
    <img
      class="on-light"
      src="/assets/mru-light.gif"
      alt={alt}
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
    <img
      class="on-dark"
      src="/assets/mru.gif"
      alt=""
      width="600"
      height="600"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
  </picture>
</span>
<MarkSvg class="mark-static" style={style(staticSize ?? size)} label="Mru mark" />

<script>
  // Show each GIF once it has loaded, so a slow or failed load shows an empty
  // space, never a half-drawn frame or a broken-image icon.
  for (const img of document.querySelectorAll<HTMLImageElement>('.mark-anim img')) {
    const play = () => img.closest('.mark-anim')?.classList.add('playing');
    if (img.complete && img.naturalWidth > 0) play();
    else img.addEventListener('load', play, { once: true });
  }
</script>
