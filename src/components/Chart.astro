---
// A chart drawn once per palette (the original SVGs from the flight and dusk
// repos). Shown as <img>: the SVGs carry their own <style>, which must not
// leak into the page. Both are lazy, so only the visible one downloads.
interface Props {
  name: 'flight-correct' | 'dusk-output' | 'dusk-sensitivity';
  alt: string;
}
const SIZES = {
  'flight-correct': [1200, 660],
  'dusk-output': [760, 420],
  'dusk-sensitivity': [760, 390],
} as const;
const { name, alt } = Astro.props;
const [w, h] = SIZES[name];
---

<img class="only-light" src={`/charts/${name}-light.svg`} alt={alt} width={w} height={h} loading="lazy" decoding="async" />
<img class="only-dark" src={`/charts/${name}-dark.svg`} alt="" width={w} height={h} loading="lazy" decoding="async" />
