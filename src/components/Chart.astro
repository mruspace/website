---
// A chart drawn once per palette (the original SVGs from the flight and dusk
// repos; flight-bench is drawn from the flight bench results by
// scripts/charts/flight-bench.mjs). Shown as <img>: the SVGs carry their own <style>, which must not
// leak into the page. Both are lazy, so only the visible one downloads.
interface Props {
  name:
    | 'flight-correct'
    | 'flight-bench'
    | 'flight-orbit'
    | 'flight-orbit-2'
    | 'dusk-output'
    | 'dusk-sensitivity'
    | 'dusk-cold-aging';
  alt: string;
}
const SIZES = {
  'flight-correct': [1200, 660],
  'flight-bench': [1200, 660],
  'flight-orbit': [1200, 560],
  'flight-orbit-2': [1200, 676],
  'dusk-output': [760, 438],
  'dusk-sensitivity': [760, 390],
  'dusk-cold-aging': [760, 400],
} as const;
const { name, alt } = Astro.props;
const [w, h] = SIZES[name];
---

<img
  class="only-light"
  src={`/charts/${name}-light.svg`}
  alt={alt}
  width={w}
  height={h}
  loading="lazy"
  decoding="async"
/>
<img class="only-dark" src={`/charts/${name}-dark.svg`} alt="" width={w} height={h} loading="lazy" decoding="async" />
